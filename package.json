{
  "name": "loop-av-middleware",
  "version": "3.0.0",
  "description": "Integración AV para shows en vivo: Resolume, Onyx y Reaper controlados desde un panel web en tablet",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node --transpile-only src/main.ts",
    "lint": "tsc --noEmit",
    "test": "node --test --require ts-node/register/transpile-only test/*.test.ts"
  },
  "keywords": [
    "artnet",
    "osc",
    "dmx",
    "resolume",
    "onyx",
    "lighting",
    "av",
    "middleware",
    "typescript",
    "live-events"
  ],
  "author": "Julian Osorio <devmaiter>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "osc": "^2.4.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
