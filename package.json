{
  "name": "loop-av-middleware",
  "version": "2.0.0",
  "description": "Middleware AV en tiempo real: OSC + Art-Net + UDP + WebSockets para control de shows en vivo",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "test-artnet": "ts-node --transpile-only src/artnet/artnetTester.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "artnet",
    "osc",
    "dmx",
    "resolume",
    "onyx",
    "lighting",
    "av",
    "middleware",
    "typescript",
    "live-events"
  ],
  "author": "Julian Osorio <devmaiter>",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "osc": "^2.4.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
